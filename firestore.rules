rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getRol() {
      return (request.auth != null && request.auth.token != null && request.auth.token.keys().hasAll(['rol'])) 
        ? request.auth.token.rol 
        : '';
    }

    // 1. GESTIÓN DE USUARIOS Y ACCESOS
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == uid || 
        getRol() == 'admin' ||
        getRol() == 'admin_sistema'
      );
    }

    // 2. PACIENTES
    match /pacientes/{pacienteId} {
      allow read, write: if request.auth != null;
    }

    // 3. PROFESIONALES Y SEDES
    match /profesionales_publicos/{profesionalId} {
      allow read: if true;
      allow write: if request.auth != null && (getRol() in ['admin', 'admin_sistema']);
    }

    match /profesionales_internos/{profesionalId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (getRol() in ['admin', 'admin_sistema', 'profesional', 'profesional_sanitario']);
    }

    match /disponibilidad_sedes/{dispoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (getRol() in ['admin', 'admin_sistema', 'profesional', 'profesional_sanitario']);
    }

    // NUEVO: Bloqueos de agenda (Vacaciones, festivos y cierres parciales)
    match /bloqueos_agenda/{bloqueoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (getRol() in ['admin', 'admin_sistema', 'profesional', 'profesional_sanitario']);
    }

    match /sedes/{sedeId} {
      allow read: if true;
      allow write: if request.auth != null && (getRol() in ['admin', 'admin_sistema']);
    }

    match /servicios/{servicioId} {
      allow read: if true;
      allow write: if request.auth != null && (getRol() in ['admin', 'admin_sistema']);
    }

    // 4. CITAS
    match /citas/{citaId} {
      allow read, write: if request.auth != null;
    }

    // 5. ACTOS CLÍNICOS
    match /actos_clinicos/{actoId} {
      allow read: if request.auth != null;
      allow create: if getRol() in ['profesional', 'profesional_sanitario'];
      allow update: if getRol() in ['admin', 'profesional', 'profesional_sanitario'];
      allow delete: if false;
    }

    // 6. SOLICITUDES DE PRUEBA
    match /solicitudes_prueba/{solicitudId} {
      allow read, write: if request.auth != null;
    }

    // 7. RESULTADOS
    match /resultados/{resultadoId} {
      allow read, write: if request.auth != null;
    }

    // 8. ASIGNACIONES DOCENTES
    match /asignaciones_docentes/{asignacionId} {
      allow read, write: if request.auth != null;
    }

    // 9. CONTENIDO DEL PORTAL
    match /contenido_portal/{contenidoId} {
      allow read: if true;
      allow write: if getRol() in ['admin', 'admin_sistema', 'editor', 'editor_contenidos'];
    }

    // 10. AUDITORÍA
    match /auditoria/{logId} {
      allow read: if request.auth != null && (
        resource.data.paciente_id == request.auth.uid ||
        getRol() in ['admin', 'admin_sistema', 'profesional', 'profesional_sanitario']
      );
      allow create: if request.auth != null && request.resource.data.usuario_id == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read: if request.auth != null;
    }

  }
}