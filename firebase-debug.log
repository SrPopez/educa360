[debug] [2026-11-11T14:00:11.619Z] >>> [apiv2][query] PUT http://127.0.0.1:8080/emulator/v1/projects/educa360-dev:securityRules [none]
[debug] [2026-11-11T14:00:11.620Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/educa360-dev:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function getRol() {\n      return (request.auth != null && request.auth.keys().hasAll(['token']) && request.auth.token != null && 'rol' in request.auth.token) \n        ? request.auth.token.rol \n        : '';\n    }\n\n    // 1. GESTIÓN DE USUARIOS Y ACCESOS\n    match /usuarios/{uid} {\n      allow read: if request.auth != null && (\n        request.auth.uid == uid || \n        getRol() == 'admin' || \n        getRol() == 'profesional'\n      );\n      allow write: if request.auth != null && (\n        request.auth.uid == uid || \n        getRol() == 'admin'\n      );\n    }\n\n    // 2. PACIENTES\n    match /pacientes/{pacienteId} {\n      allow read: if request.auth != null && (\n        getRol() == 'admin' || \n        (getRol() == 'paciente' && request.auth.uid == pacienteId) ||\n        getRol() == 'profesional' ||\n        getRol() == 'estudiante'\n      );\n      allow write: if request.auth != null && (\n        getRol() == 'admin' || \n        getRol() == 'profesional'\n      );\n    }\n\n    // 3. PROFESIONALES\n    match /profesionales/{profesionalId} {\n      allow read: if request.auth != null;\n      allow write: if request.auth != null && getRol() == 'admin';\n    }\n\n    // 4. CITAS\n    match /citas/{citaId} {\n      allow read, write: if request.auth != null && (\n        getRol() == 'admin' || \n        getRol() == 'profesional' || \n        getRol() == 'paciente'\n      );\n    }\n\n// 5. ACTOS CLÍNICOS\n    match /actos_clinicos/{actoId} {\n      allow read: if request.auth != null && (\n        resource == null || \n        resource.data.professional_id == request.auth.uid ||\n        resource.data.paciente_id == request.auth.uid ||\n        getRol() == 'admin' || \n        getRol() == 'profesional' || // Permite lectura a cualquier profesional\n        getRol() == 'docente' ||\n        (getRol() == 'estudiante' && exists(/databases/$(database)/documents/asignaciones_docentes/$(request.auth.uid)))\n      );\n      \n      allow create: if request.auth != null && getRol() == 'profesional';\n      \n      allow update: if request.auth != null \n        && resource != null \n        && resource.data.estado == 'Borrador' \n        && request.resource.data.estado in ['Borrador', 'Firmado']\n        && (getRol() == 'admin' || getRol() == 'profesional');\n        \n      allow delete: if false;\n    }\n\n    // 6. SOLICITUDES DE PRUEBA\n    match /solicitudes_prueba/{solicitudId} {\n      allow read: if request.auth != null && (\n        getRol() == 'admin' || \n        getRol() == 'profesional' || \n        getRol() == 'paciente'\n      );\n      allow write: if request.auth != null && (\n        getRol() == 'admin' || \n        getRol() == 'profesional'\n      );\n    }\n\n    // 7. RESULTADOS\n    match /resultados/{resultadoId} {\n      allow read: if request.auth != null && (\n        getRol() == 'admin' || \n        getRol() == 'profesional' || \n        getRol() == 'paciente'\n      );\n      allow write: if request.auth != null && (\n        getRol() == 'admin' || \n        getRol() == 'profesional'\n      );\n    }\n\n    // 8. ASIGNACIONES DOCENTES\n    match /asignaciones_docentes/{asignacionId} {\n      allow read: if request.auth != null && (\n        getRol() == 'admin' || \n        getRol() == 'docente' || \n        getRol() == 'estudiante' || \n        getRol() == 'profesional'\n      );\n      allow write: if request.auth != null && (\n        getRol() == 'admin' || \n        getRol() == 'docente'\n      );\n    }\n\n    // 9. CONTENIDO DEL PORTAL\n    match /contenido_portal/{contenidoId} {\n      allow read: if true;\n      allow write: if request.auth != null && (getRol() == 'admin' || getRol() == 'editor');\n    }\n\n// 10. AUDITORÍA\n    match /auditoria/{logId} {\n      allow read: if request.auth != null && (\n        resource.data.paciente_id == request.auth.uid || // <--- Restaurado para el paciente\n        getRol() == 'admin' ||\n        getRol() == 'profesional'\n      );\n      \n      allow create: if request.auth != null;\n      \n      allow update, delete: if false;\n    }\n\n  }\n}"}]}}
